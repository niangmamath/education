# The isolated content origin, ADR-012 condition 5.
#
# A **template**, and not a plain configuration: `frame-ancestors` names the one
# origin allowed to frame a content, and that origin changes with where the site
# is served from. It was hardcoded to `http://localhost:3000`, which is right on
# a laptop and silently wrong everywhere else — behind a tunnel the browser would
# refuse to display the frame, and nothing in the logs would say why. The nginx
# image expands `${WEB_ORIGIN}` at startup, so the value follows the site.
#
# It is a different origin from the application on purpose: a content that
# misbehaves must not be able to read the application's cookies, and the browser
# is what enforces that — provided the two are genuinely not the same site.
#
# **This origin no longer reads the deployed content from a local disk, and no
# longer talks to the bucket that holds it either.** A disk shared between this
# service and the API's is exactly the thing most multi-service platforms
# (Render among them) refuse to offer, so the deployed content moved to a
# private bucket — and on Render, that bucket's private address exists only as
# an `/etc/hosts` entry, which nginx's dynamic resolver never consults, by
# design, on any platform. So every ticketed request is proxied to the API
# instead: it checks the ticket and streams the bytes itself, reaching the
# bucket the same way `register`/`deploy` always have. One more hop, to an
# address this origin has always been able to reach, rather than one it never
# reliably could. The player bundle is the one exception — it carries no ticket
# and is useless without a content, so it ships baked into this image instead
# (`infrastructure/nginx/Dockerfile`), and is still served from local disk.

server {
    listen 80;
    server_name _;

    # Needed because `proxy_pass` below targets a URL held in a variable —
    # nginx cannot resolve that host at config-load time the way it resolves a
    # literal one, so it is told where to ask instead. `NGINX_LOCAL_RESOLVERS`
    # is not ours: it is the official nginx image's own entrypoint script
    # (`15-local-resolvers.envsh`), which reads whatever nameserver the
    # platform already put in `/etc/resolv.conf` and exports it before this
    # template is rendered — Docker Compose's embedded DNS locally, whatever
    # Render's public DNS resolver is there, and so on.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    # No cookie of this origin is ever set, and none of the application's can
    # arrive here: that is the whole point of the separation.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors ${WEB_ORIGIN}; base-uri 'none'; form-action 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;

    # `unsafe-eval` and `unsafe-inline` are what the H5P runtime needs to run at
    # all; they are tolerable here precisely because this origin holds nothing
    # worth stealing — no cookie, no storage, no credential — and cannot reach
    # anything that does.
    #
    # `frame-ancestors` is the other half of that bargain: this origin is only
    # ever displayed inside our own site. Without it, anybody could frame a
    # content and pass it off as theirs.

    root /srv/content;
    autoindex off;
    charset utf-8;

    # The player page and its bundle carry no content of their own and need no
    # ticket; they are baked into this image at build time, the same "frozen
    # artefact" ADR-012's third condition asks of the libraries, just for
    # something that never changes per deployment.
    location /player/ {
        try_files $uri =404;
    }

    # Everything a content is made of lives behind a ticket segment:
    # `/t/<ticket>/content/<empreinte>/…` and `/t/<ticket>/libraries/…`.
    #
    # The ticket is in the **path** and not in the query, and that is a
    # correction kept from an earlier design. A player composes an asset URL by
    # joining path segments; a query string is not one, so it was dropped the
    # moment the player asked for anything of its own, and every asset arrived
    # without a ticket. A path prefix survives that joining by construction —
    # the platform no longer has to control every URL the player invents.
    #
    # The whole path is forwarded unchanged: the API's own routes match this
    # exact shape (`app/api/v1/internal.py`), so there is nothing here to
    # rewrite, only somewhere to send it.
    location ~ ^/t/[^/]+/(?:content|libraries)/ {
        set $api_upstream ${API_ORIGIN};
        proxy_ssl_server_name on;
        proxy_pass $api_upstream;
    }

    # The same trees without a ticket are not a different way in: they are not a
    # way in at all.
    location /content/ { return 404; }
    location /libraries/ { return 404; }

    location = /health {
        access_log off;
        return 200 "content-origin\n";
    }

    location / {
        return 404;
    }
}
