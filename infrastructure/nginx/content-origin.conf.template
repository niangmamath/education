# The isolated content origin, ADR-012 condition 5.
#
# A **template**, and not a plain configuration: `frame-ancestors` names the one
# origin allowed to frame a content, and that origin changes with where the site
# is served from. It was hardcoded to `http://localhost:3000`, which is right on
# a laptop and silently wrong everywhere else — behind a tunnel the browser would
# refuse to display the frame, and nothing in the logs would say why. The nginx
# image expands `${WEB_ORIGIN}` at startup, so the value follows the site.
#
# It is a different origin from the application on purpose: a content that
# misbehaves must not be able to read the application's cookies, and the browser
# is what enforces that — provided the two are genuinely not the same site.
#
# Nothing here is public. Every request for a content is checked, before a byte
# is served, against a ticket the API minted for one child doing one activity.
# The check is `auth_request`, so nginx never learns who anyone is; it asks and
# obeys.

server {
    listen 80;
    server_name _;

    # No cookie of this origin is ever set, and none of the application's can
    # arrive here: that is the whole point of the separation.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors ${WEB_ORIGIN}; base-uri 'none'; form-action 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;

    # `unsafe-eval` and `unsafe-inline` are what the H5P runtime needs to run at
    # all; they are tolerable here precisely because this origin holds nothing
    # worth stealing — no cookie, no storage, no credential — and cannot reach
    # anything that does.
    #
    # `frame-ancestors` is the other half of that bargain: this origin is only
    # ever displayed inside our own site. Without it, anybody could frame a
    # content and pass it off as theirs.

    root /srv/content;
    autoindex off;
    charset utf-8;

    # The API answers 204 when the ticket in the path opens what is being asked
    # for, and 403 otherwise. nginx caches nothing of it: a ticket revoked when
    # the child finishes must stop working at once.
    location = /_ticket {
        internal;
        proxy_pass http://api:8000/api/v1/internal/content-access;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        # The whole original URI, ticket and all. An `auth_request` subrequest
        # has its own variable cache, so anything the protected location
        # computed would arrive empty here; the API parses the URI instead,
        # which is one place instead of two and cannot be got subtly wrong in a
        # configuration file.
        proxy_set_header X-Original-URI $request_uri;
    }

    # The player page and its bundle carry no content of their own, so they are
    # served without a ticket; they are useless without one.
    location /player/ {
        try_files $uri =404;
    }

    # Everything a content is made of lives behind a ticket segment:
    # `/t/<ticket>/content/<empreinte>/…` and `/t/<ticket>/libraries/…`.
    #
    # The ticket is in the **path** and not in the query, and that is a
    # correction. A player composes an asset URL by joining path segments; a
    # query string is not one, so it was dropped the moment the player asked for
    # anything of its own, and every asset arrived without a ticket. A path
    # prefix survives that joining by construction — the platform no longer has
    # to control every URL the player invents.
    location ~ ^/t/[^/]+/(?:content|libraries)/ {
        auth_request /_ticket;
        rewrite ^/t/[^/]+/(.*)$ /$1 break;
        try_files $uri =404;
    }

    # The same trees without a ticket are not a different way in: they are not a
    # way in at all.
    location /content/ { return 404; }
    location /libraries/ { return 404; }

    location = /health {
        access_log off;
        return 200 "content-origin\n";
    }

    location / {
        return 404;
    }
}
