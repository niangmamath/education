# =============================================================================
# StudentConnect API — variables d'environnement
# =============================================================================
# Copier ce fichier en `.env` pour travailler depuis la machine, hors conteneur.
# Les valeurs ci-dessous visent les services du compose publiés sur la boucle
# locale ; le `.env` de la racine, lu par Docker Compose, parle lui les noms
# d'hôtes du réseau du compose (`postgres`, `redis`, `storage`).
#
# Les clés sont celles de `app/core/config.py`. Une clé absente d'ici et présente
# là-bas garde sa valeur par défaut.
# =============================================================================

# Environnement
ENVIRONMENT=development
DEBUG=true

# API
API_TITLE=StudentConnect API
API_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Origines CORS. **Forme JSON obligatoire dans un fichier dotenv** :
# pydantic-settings décode un champ composite avant que le validateur du projet
# ne voie la valeur, donc la forme séparée par des virgules échoue ici — elle ne
# vaut que pour une vraie variable d'environnement.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# PostgreSQL. Le port publié est celui de `POSTGRES_PORT` dans le `.env` de la
# racine ; il vaut 5432 par défaut, à changer si la machine l'occupe déjà.
DATABASE_URL=postgresql+asyncpg://studentconnect:studentconnect_dev_only@localhost:5432/studentconnect
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Sécurité. `SECRET_KEY` sert de clé au pseudonyme d'acteur xAPI (ADR-014) :
# laissée vide, la dérivation fonctionne encore mais n'est plus secrète.
SECRET_KEY=change-me-in-production-use-secrets-manager

# Stockage compatible S3 (MinIO en local)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=studentconnect_local
S3_SECRET_KEY=studentconnect_local_secret
S3_REGION=us-east-1
S3_BUCKET_H5P_PACKAGES=studentconnect-h5p-packages
S3_BUCKET_H5P_RUNTIME=studentconnect-h5p-runtime
S3_BUCKET_MEDIA=studentconnect-media
S3_BUCKET_PRIVATE_EVIDENCE=studentconnect-private-evidence
S3_BUCKET_THUMBNAILS=studentconnect-thumbnails

# Runtime de contenu (ADR-012, condition 5). Le déploiement écrit dans
# S3_BUCKET_H5P_RUNTIME ci-dessus, pas sur un disque : les commandes de
# déploiement se lancent donc dans le conteneur `api`, comme avant, mais rien
# n'y est plus partagé avec l'origine de contenu.
CONTENT_ORIGIN_URL=http://localhost:8081

# Journalisation
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# En production, passer par un gestionnaire de secrets.
# =============================================================================
