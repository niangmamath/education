# Git Attributes for StudentConnect
# https://git-scm.com/docs/gitattributes

# =============================================================================
# Fichiers texte - Normaliser les fins de ligne
# =============================================================================

# Auto-detect text files and perform LF normalization
* text=auto

# Force LF line endings for text files
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Python files - LF line endings
*.py text eol=lf

# Shell scripts - LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Makefile - LF line endings
Makefile text eol=lf

# Docker files - LF line endings
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf

# =============================================================================
# Fichiers binaires - Pas de conversion
# =============================================================================

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.h5p binary

# =============================================================================
# Diffusion et fusion
# =============================================================================

# Treat as binary for diff/merge
*.png -diff -merge
*.jpg -diff -merge
*.jpeg -diff -merge
*.gif -diff -merge
*.ico -diff -merge
*.bmp -diff -merge

# Special merge driver for lock files
package-lock.json merge=union
package.json merge=union
yarn.lock merge=union
pnpm-lock.yaml merge=union

# =============================================================================
# Langage spécifique
# =============================================================================

# JavaScript/TypeScript - utiliser linguist pour la détection de langage
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript

# Python
*.py linguist-language=Python

# SQL
*.sql linguist-language=SQL

# HTML
*.html linguist-language=HTML

# CSS
*.css linguist-language=CSS

# YAML
*.yaml linguist-language=YAML
*.yml linguist-language=YAML

# JSON
*.json linguist-language=JSON

# Markdown
*.md linguist-language=Markdown

# =============================================================================
# Encodage
# =============================================================================

# Force UTF-8 encoding for text files
*.txt working-tree-encoding=UTF-8
*.md working-tree-encoding=UTF-8
*.json working-tree-encoding=UTF-8
*.yaml working-tree-encoding=UTF-8
*.yml working-tree-encoding=UTF-8
*.py working-tree-encoding=UTF-8
*.js working-tree-encoding=UTF-8
*.ts working-tree-encoding=UTF-8
*.tsx working-tree-encoding=UTF-8
*.jsx working-tree-encoding=UTF-8

# =============================================================================
# Export de merge
# =============================================================================

# Configuration pour éviter les conflits inutiles
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore

# =============================================================================
# Filter et Smudge
# =============================================================================

# Filtre pour les fichiers de configuration sensible
# (non utilisé actuellement, mais disponible pour l'avenir)
# *.env filter=env

# =============================================================================
# Attributs spécifiques à GitHub
# =============================================================================

# GitHub linguist
.github/ linguist-vendored
.idea/ linguist-vendored
.vscode/ linguist-vendored

# =============================================================================
# Attributs pour les fichiers générés
# =============================================================================

# Ignorer les changements de whitespace pour certains fichiers
*.min.js -whitespace
*.min.css -whitespace

# =============================================================================
# Attributs pour les fichiers de migration
# =============================================================================

# Alembic migrations - garder l'historique
alembic/versions/*.py merge=union
alembic/env.py merge=union

# =============================================================================
# Attributs pour les fichiers de dépendances
# =============================================================================

# Node modules - ne pas tracker
node_modules/ linguist-vendored

# Python virtual environments - ne pas tracker
.venv/ linguist-vendored
venv/ linguist-vendored
env/ linguist-vendored

# =============================================================================
# FIN
# =============================================================================
