# EditorConfig helps maintain consistent coding styles across different editors
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Matche les fichiers Markdown
[*.md]
max_line_length = 120
trim_trailing_whitespace = false

# Matche les fichiers YAML
[*.yml]
indent_size = 2

# Matche les fichiers YAML (autre extension)
[*.yaml]
indent_size = 2

# Matche les fichiers JSON
[*.json]
indent_size = 2

# Matche les fichiers JSONC (JSON avec commentaires)
[*.jsonc]
indent_size = 2

# Matche les fichiers JavaScript
[*.js]
indent_size = 2

# Matche les fichiers TypeScript
[*.ts]
indent_size = 2

# Matche les fichiers JSX
[*.jsx]
indent_size = 2

# Matche les fichiers TSX
[*.tsx]
indent_size = 2

# Matche les fichiers Python
[*.py]
indent_size = 4
max_line_length = 88

# Matche les fichiers SQL
[*.sql]
indent_size = 4

# Matche les fichiers HTML
[*.html]
indent_size = 2

# Matche les fichiers CSS
[*.css]
indent_size = 2

# Matche les fichiers SCSS
[*.scss]
indent_size = 2

# Matche les fichiers LESS
[*.less]
indent_size = 2

# Matche les fichiers Dockerfile
[Dockerfile*]
indent_size = 4

# Matche les fichiers shell
[*.sh]
indent_size = 2

# Matche les fichiers Makefile
[Makefile]
indent_style = tab

# Matche les fichiers TOML
[*.toml]
indent_size = 2

# Matche les fichiers INI
[*.ini]
indent_size = 2

# Matche les fichiers ENV
[*.env*]
indent_size = 2
trim_trailing_whitespace = false

# Matche les fichiers .gitignore
[.gitignore]
trim_trailing_whitespace = false

# Configuration spécifique pour Visual Studio Code
[.vscode/**]
indent_size = 2

# Configuration pour les fichiers de configuration
[package.json]
indent_size = 2

# Configuration pour les fichiers de lock
[package-lock.json]
indent_size = 2

# Configuration pour les fichiers de lock Yarn
[yarn.lock]
indent_size = 2

# Configuration pour les fichiers de lock pnpm
[pnpm-lock.yaml]
indent_size = 2

# Configuration pour les fichiers de configuration Python
[requirements.txt]
indent_size = 2

# Configuration pour les fichiers de configuration Python avancée
[requirements-*.txt]
indent_size = 2

# Configuration pour pyproject.toml
[pyproject.toml]
indent_size = 2
