# =============================================================================
# StudentConnect - Configuration d'environnement
# =============================================================================
# COPIER ce fichier en .env pour votre configuration locale
# NE JAMAIS COMMITER .env dans le dépôt
# =============================================================================

# =============================================================================
# Application
# =============================================================================

# Nom de l'application
APP_NAME=StudentConnect

# Environnement (development, staging, production)
NODE_ENV=development
PYTHON_ENV=development

# Ports
NEXT_PUBLIC_WEB_PORT=3000
FASTAPI_PORT=8000

# =============================================================================
# Backend FastAPI
# =============================================================================

# URL du backend (pour le frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clé secrète pour FastAPI (générer une nouvelle pour la production)
# Utiliser : openssl rand -hex 32
SECRET_KEY=changer_pour_une_valeur_secrete_aleatoire

# Algorithm de hachage
ALGORITHM=HS256

# Durée d'expiration des tokens (en minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Base de données PostgreSQL
# =============================================================================

# URL de connexion PostgreSQL (format : postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studentconnect_dev

# Configuration détaillée (alternative)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=studentconnect_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Pool de connexions SQLAlchemy
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=False

# =============================================================================
# Redis (Sessions et Cache)
# =============================================================================

# URL Redis
REDIS_URL=redis://localhost:6379/0

# Configuration détaillée
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Préfixe pour les clés Redis
REDIS_PREFIX=studentconnect:

# Durée d'expiration des sessions (en secondes)
SESSION_EXPIRE_SECONDS=86400

# =============================================================================
# Stockage S3 Compatible
# =============================================================================

# Pour développement local avec MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=studentconnect
S3_REGION=us-east-1

# Pour production (AWS S3, DigitalOcean Spaces, etc.)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=votre_access_key
# S3_SECRET_KEY=votre_secret_key
# S3_BUCKET=votre_bucket
# S3_REGION=votre_region

# URL publique pour accéder aux fichiers
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000

# Durée d'expiration des URLs présignées (en secondes)
S3_PRESIGNED_URL_EXPIRE=3600

# =============================================================================
# Celery (Tâches asynchrones)
# =============================================================================

# Broker URL (Redis)
CELERY_BROKER_URL=redis://localhost:6379/1

# Result backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Nom de la queue par défaut
CELERY_DEFAULT_QUEUE=default

# =============================================================================
# H5P
# =============================================================================

# Dossier temporaire pour les uploads H5P
H5P_TEMP_DIR=./h5p-temp

# Dossier de quarantaine pour les paquets H5P
H5P_QUARANTINE_DIR=./h5p-quarantine

# Dossier de stockage des paquets validés
H5P_STORAGE_DIR=./h5p-storage

# Types H5P autorisés (séparés par des virgules)
H5P_ALLOWED_TYPES=H5P.Example,H5P.Quiz,H5P.InteractiveVideo,H5P.CoursePresentation

# Taille maximale des uploads H5P (en octets)
H5P_MAX_UPLOAD_SIZE=52428800

# =============================================================================
# PhET
# =============================================================================

# URL de base pour les simulations PhET
NEXT_PUBLIC_PHET_BASE_URL=https://phet.colorado.edu

# Liste des simulations PhET autorisées (séparées par des virgules)
# Exemple : fraction-matcher,area-builder,balancing-act
NEXT_PUBLIC_PHET_ALLOWED_SIMS=

# =============================================================================
# Authentification
# =============================================================================

# Durée d'expiration des cookies de session (en jours)
SESSION_COOKIE_EXPIRE_DAYS=7

# Nom du cookie de session
SESSION_COOKIE_NAME=studentconnect_session

# Domaine du cookie (laisser vide pour développement local)
SESSION_COOKIE_DOMAIN=

# Secure cookie (true pour HTTPS en production)
SESSION_COOKIE_SECURE=false

# HttpOnly cookie
SESSION_COOKIE_HTTPONLY=true

# SameSite cookie
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# Email (pour vérification des comptes parents)
# =============================================================================

# SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_app
SMTP_USE_TLS=true

# Email de l'expéditeur
EMAIL_FROM=noreply@studentconnect.test
EMAIL_FROM_NAME=StudentConnect

# =============================================================================
# Frontend Next.js
# =============================================================================

# URL du frontend
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Locale par défaut
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Locales supportées (séparées par des virgules)
NEXT_PUBLIC_LOCALES=fr,en

# =============================================================================
# Logging
# =============================================================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Format des logs (json, text)
LOG_FORMAT=json

# Dossier des logs
LOG_DIR=./logs

# =============================================================================
# Sécurité
# =============================================================================

# Clé secrète pour CSRF
CSRF_SECRET=changer_pour_une_valeur_secrete_aleatoire

# Durée d'expiration des tokens CSRF (en secondes)
CSRF_TOKEN_EXPIRE=3600

# Headers CORS autorisés
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Rate Limiting
# =============================================================================

# Nombre maximal de requêtes par minute
RATE_LIMIT_REQUESTS=100

# Durée de la fenêtre (en secondes)
RATE_LIMIT_WINDOW=60

# =============================================================================
# Tests
# =============================================================================

# Base de données de test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studentconnect_test

# =============================================================================
# Performance Monitoring
# =============================================================================

# OpenTelemetry
OTEL_SERVICE_NAME=studentconnect
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# NE JAMAIS AJOUTER DE VALEURS RÉELLES CI-DESSUS
# =============================================================================
# Pour la production, utiliser des variables d'environnement sécurisées
# via le système d'hébergement (AWS Secrets Manager, GitHub Secrets, etc.)
# =============================================================================
