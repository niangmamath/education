ENVIRONMENT=development
# Derrière un tunnel (ngrok, démo publique) : DEBUG=false, sinon une erreur
# 500 renvoie le message d'exception brut à quiconque la déclenche, et
# SESSION_COOKIE_SECURE=true, sinon le cookie de session part sans `Secure`.
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# La seule origine autorisée à afficher un contenu H5P dans un cadre, posée par
# l'en-tête `frame-ancestors` de l'origine de contenu. Derrière un tunnel, c'est
# l'adresse publique du site — sinon le navigateur refuse le cadre, en silence
# côté serveur.
WEB_ORIGIN=http://localhost:3000

# Requis, sans valeur par défaut : dérive le pseudonyme xAPI d'un enfant (voir
# app/xapi/statements.py). À générer une fois par poste, jamais partagé ni
# commité :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

POSTGRES_DB=studentconnect
POSTGRES_USER=studentconnect
POSTGRES_PASSWORD=studentconnect_dev_only
# Port publié sur la boucle locale, pour lancer migrations et tests depuis la
# machine. À changer si 5432 est déjà pris. Sans effet sur le réseau du
# compose, où la base reste jointe en 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://studentconnect:studentconnect_dev_only@postgres:5432/studentconnect

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT_URL=http://storage:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=studentconnect_local
S3_SECRET_KEY=studentconnect_local_secret
S3_REGION=us-east-1
S3_BUCKET_H5P_PACKAGES=studentconnect-h5p-packages
S3_BUCKET_H5P_RUNTIME=studentconnect-h5p-runtime
S3_BUCKET_MEDIA=studentconnect-media
S3_BUCKET_PRIVATE_EVIDENCE=studentconnect-private-evidence
S3_BUCKET_THUMBNAILS=studentconnect-thumbnails

NEXT_PUBLIC_API_URL=http://localhost:8000

# Content runtime, ADR-012 condition 5: served from its own origin. The
# deployed tree lives in S3_BUCKET_H5P_RUNTIME above, not on a disk shared with
# the content origin, which fetches a file back through a signed URL instead.
CONTENT_PORT=8081
CONTENT_ORIGIN_URL=http://localhost:8081
